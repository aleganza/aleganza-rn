{
  "name": "aleganza-rn",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "tunnel": "expo start --tunnel",
    "build:ios:dev": "eas build --profile development --platform ios",
    "build:ios:prod": "eas build --profile production --platform ios",
    "build:android:dev": "eas build --profile development --platform android",
    "build:android:prod": "eas build --profile production --platform android",
    "build:prod": "eas build --profile production --platform all",
    "refresh": "rm -rf node_modules pnpm-lock.yaml package-lock.json",
    "clean-start": "pnpm run refresh && expo start -c",
    "typecheck": "tsc --noEmit",
    "docscheck": "node scripts/check-docs.mjs",
    "check": "pnpm docscheck && pnpm typecheck"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.14",
    "@mingcute/react-native": "^3.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@tanstack/react-query": "^5.104.5",
    "expo": "~57.0.31",
    "expo-application": "~57.0.3",
    "expo-asset": "~57.0.20",
    "expo-blur": "~57.0.3",
    "expo-brightness": "~57.0.2",
    "expo-constants": "~57.0.22",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-notifications": "~57.0.24",
    "expo-router": "~57.0.29",
    "expo-screen-orientation": "~57.0.3",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.26",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-actions-sheet": "^0.9.7",
    "react-native-compressor": "^1.16.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-haptic-feedback": "^3.0.0",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-video": "^6.19.0",
    "react-native-worklets": "0.10.1",
    "subtitles-parser-vtt": "^0.1.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@expo/dom-webview": "~57.0.1",
    "@types/react": "~19.2.14",
    "typescript": "~6.0.3"
  },
  "private": true
}